# Copy this file to .env and adjust values for your environment.

# --- Storage mode options (choose ONE) ---

# 1) SQLite (recommended for local dev)
# SQLITE_PATH=.data/brasiltec.sqlite

# 2) PostgreSQL (remote or local server)
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Alternative SQLite syntax via DATABASE_URL:
# DATABASE_URL=sqlite:.data/brasiltec.sqlite

# Optional explicit environment mode
# NODE_ENV=development

# --- Pagamentos (Mercado Pago) ---

# Modo de gateway:
# - simulação/local: deixe vazio ou use qualquer valor diferente de webhook
# - real/webhook-first: webhook
# PAYMENT_GATEWAY_MODE=webhook

# Provedor de pagamento real (atual)
# PAYMENT_GATEWAY_PROVIDER=mercado_pago

# Token de acesso (credenciais da sua aplicação no Mercado Pago)
# MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Moeda da preferência (para Brasil, normalmente BRL)
# MERCADO_PAGO_CURRENCY=BRL

# URL pública base da aplicação (usada para back_urls)
# APP_BASE_URL=https://seu-dominio.com

# URL pública do webhook (opcional; se ausente usa APP_BASE_URL + /api/payments/webhook)
# PAYMENT_WEBHOOK_URL=https://seu-dominio.com/api/payments/webhook

# Chave secreta do webhook nativo do Mercado Pago (x-signature)
# MERCADO_PAGO_WEBHOOK_SECRET=

# Webhook externo para alertas operacionais de pagamentos (Slack/Teams/servico de monitoramento)
# PAYMENT_ALERTS_WEBHOOK_URL=https://hooks.exemplo.com/services/...

# Timeout do envio de alerta (ms)
# PAYMENT_ALERTS_WEBHOOK_TIMEOUT_MS=4000

# Severidade minima para notificar: warning | error | critical
# PAYMENT_ALERTS_MIN_SEVERITY=warning

# Janela de deduplicacao por tipo de falha (segundos)
# PAYMENT_ALERTS_COOLDOWN_SECONDS=300

# Token para executar conciliacao via endpoint seguro POST /api/payments/reconcile
# PAYMENT_RECONCILE_TOKEN=troque-por-um-token-forte

# URL completa do endpoint de conciliacao (usada por scripts e jobs externos)
# PAYMENT_RECONCILE_URL=https://seu-dominio.com/api/payments/reconcile

# Limite maximo de pedidos pendentes por rodada de conciliacao
# PAYMENT_RECONCILE_MAX_ORDERS=50

# Idade minima do pedido (em minutos) para entrar na conciliacao
# PAYMENT_RECONCILE_MIN_ORDER_AGE_MINUTES=2

# Assinatura HMAC genérica do endpoint customizado (não usada no webhook nativo do Mercado Pago)
# PAYMENT_WEBHOOK_SECRET=

# --- Suporte por email (contato do site para destinatário) ---

# Destinatário padrão para chamados enviados no formulário de suporte
# SUPPORT_DEFAULT_RECIPIENT=suporte@brasiltec.com

# Lista de destinatários autorizados (evita open relay)
# SUPPORT_ALLOWED_RECIPIENTS=suporte@brasiltec.com,operacoes@brasiltec.com

# Provedor de envio:
# - log: apenas registra no servidor (desenvolvimento)
# - resend: envio real por API HTTP
# SUPPORT_EMAIL_PROVIDER=log

# Necessário quando SUPPORT_EMAIL_PROVIDER=resend
# SUPPORT_EMAIL_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SUPPORT_EMAIL_FROM=Brasiltec <noreply@seu-dominio.com>
